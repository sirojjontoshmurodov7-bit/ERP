# docker-compose.prod.yml uchun. Nusxa oling: .env.production (gitga QO'SHILMAYDI).
# Sirlarni yarating: openssl rand -hex 32   (faqat hex belgilar: qochirish muammosi bo'lmaydi)

DOMAIN=erp.example.uz

# Baza: egasi (migratsiya) va ilova roli (RLS bilan)
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=erp
APP_DB_PASSWORD=

# JWT (har biri kamida 32 belgi, ikkalasi har xil)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Telegram (ixtiyoriy): BotFather tokeni, bot nomi, webhook siri
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# true: webhook o'rniga long polling (ommaviy HTTPS kerak emas, faqat bitta API nusxasi)
TELEGRAM_POLLING=
# Ichki kundalik eslatma vaqti HH:MM (Asia/Tashkent), masalan 09:00. Bo'sh: faqat tashqi cron yoki qo'lda
NOTIFY_DAILY_AT=
# Tashqi cron (masalan cron-job.org) uchun sir
CRON_SECRET=
