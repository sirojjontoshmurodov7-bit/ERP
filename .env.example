# Postgres (docker compose bilan mos)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
POSTGRES_PORT=5432

# API
API_PORT=3001
# Ilova roli (RLS ishlashi uchun superuser EMAS) va migratsiya roli
DATABASE_URL=postgresql://erp_app:erp_app_password@localhost:5432/erp
DATABASE_MIGRATION_URL=postgresql://erp:erp_dev_password@localhost:5432/erp

# Auth (ishlab chiqarishda uzun tasodifiy qiymat qo'ying)
JWT_ACCESS_SECRET=change-me-access-secret-please-use-long-random
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-long-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Telegram bot (21-qadam; ixtiyoriy). Webhook: setWebhook url=<API>/telegram/webhook, secret_token=TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Tashqi cron-trigger (masalan cron-job.org) POST /notifications/cron uchun, header: x-cron-secret
CRON_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
