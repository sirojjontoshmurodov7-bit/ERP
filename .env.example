# Postgres (docker compose bilan mos)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
POSTGRES_PORT=5432

# API
API_PORT=3001
# Ilova roli (RLS ishlashi uchun superuser EMAS) va migratsiya roli
DATABASE_URL=postgresql://erp_app:erp_app_password@localhost:5432/erp
DATABASE_MIGRATION_URL=postgresql://erp:erp_dev_password@localhost:5432/erp

# Auth (ishlab chiqarishda uzun tasodifiy qiymat qo'ying)
JWT_ACCESS_SECRET=change-me-access-secret-please-use-long-random
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-long-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# API oldidagi ishonchli proksilar soni (web BFF orqali kelganda mijoz IP'si uchun). API tashqaridan to'g'ridan-to'g'ri ochiq bo'lsa QO'YMANG.
TRUST_PROXY=

# Telegram bot (21-qadam; ixtiyoriy). Webhook: setWebhook url=<API>/telegram/webhook, secret_token=TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# true: webhook o'rniga long polling (ommaviy HTTPS kerak emas, faqat bitta API nusxasi)
TELEGRAM_POLLING=
# Ichki kundalik eslatma vaqti HH:MM (Asia/Tashkent), masalan 09:00. Bo'sh: faqat tashqi cron yoki qo'lda
NOTIFY_DAILY_AT=
# Tashqi cron-trigger (masalan cron-job.org) POST /notifications/cron uchun, header: x-cron-secret
CRON_SECRET=

# Web (BFF): brauzer API'ga to'g'ridan-to'g'ri murojaat qilmaydi, Next.js server orqali
API_URL=http://localhost:3001
# Prod'da cookie'lar Secure bo'ladi (HTTPS). Lokal http uchun false.
WEB_SECURE_COOKIES=false
